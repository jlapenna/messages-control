{
  "manifest_version": 3,
  "name": "Messages Control",
  "version": "0.1.0",
  "description": "Classifies Google Messages threads with your chosen LLM endpoint and applies your cleanup rules.",
  "permissions": [
    "storage",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://messages.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://messages.google.com/web/*"
      ],
      "js": [
        "messages-dom.js",
        "policy.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Messages Control"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "panel.html"
  }
}
