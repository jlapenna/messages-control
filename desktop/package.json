{
  "name": "messages-control-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop shell for Messages Control: runs the watcher, shows the dashboard, pairs in a window",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "net.jlapenna.messages-control",
    "productName": "Messages Control",
    "files": ["main.js", "preload.js"],
    "extraResources": [{ "from": "..", "to": "app", "filter": ["bin/**", "src/**", "*.js", "package.json", "LICENSE", "node_modules/**"] }]
  }
}
