{
  "name": "messages-control",
  "version": "0.2.0",
  "description": "Watches Google Messages for Web and sorts spam, codes and notices with an LLM",
  "main": "background.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node bin/messages-control.js",
    "prepare": "husky",
    "test:integration": "node --test test/integration/*.test.js",
    "test:all": "npm test && npm run test:integration",
    "test:desktop": "node --test desktop/test/*.test.cjs",
    "postinstall": "node tools/sync-package-skills.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlapenna/messages-control.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jlapenna/messages-control/issues"
  },
  "homepage": "https://github.com/jlapenna/messages-control#readme",
  "private": true,
  "bin": {
    "messages-control": "./bin/messages-control.js"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "files": [
    "bin",
    "src",
    "content.js",
    "messages-dom.js",
    "message-events.js",
    "policy.js",
    "settings.js",
    "README.md",
    "LICENSE",
    "tools/sync-package-skills.mjs"
  ],
  "devDependencies": {
    "@jlapenna/repo-tools": "github:jlapenna/repo-tools#v4.10.0",
    "husky": "^9.1.7",
    "modern-web-guidance": "1.0.1"
  },
  "overrides": {
    "nx@23.3.0": {
      "undici": "7.30.2",
      "minimatch": "10.2.5"
    },
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
